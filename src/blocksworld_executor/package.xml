<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>blocksworld_executor</name>
  <version>0.1.0</version>
  <description>ROS 2 and MoveIt 2 executor for planned knock-pick action sequences.</description>
  <maintainer email="Hao.Lu@anu.edu.au">Hao Lu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_task_constructor_core</depend>
  <depend>moveit_core</depend>

  <build_depend>nlohmann-json3-dev</build_depend>
  <exec_depend>nlohmann-json3-dev</exec_depend>

  <build_depend>blocksworld_scene</build_depend>
  <build_export_depend>blocksworld_scene</build_export_depend>
  <exec_depend>blocksworld_scene</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
